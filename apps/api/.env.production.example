# CHINA ORDER TZ API — Production environment template
# Copy to project root .env for Docker Compose production:
#   cp apps/api/.env.production.example .env
# Then fill secrets (APP_KEY, DB passwords, NMB, SMTP) before:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

APP_NAME="CHINA ORDER TZ API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=china_order_tz
DB_USERNAME=china_order
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (required for password reset, verification, email change) ───────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://your-domain.com
SANCTUM_STATEFUL_DOMAINS=your-domain.com,www.your-domain.com
SANCTUM_ADMIN_EXPIRATION_MINUTES=480
SANCTUM_CUSTOMER_EXPIRATION_MINUTES=10080

# ── Next.js production web image (Docker build args — docker-compose.prod.yml web.build) ──
# Production: https://www.chinaordertz.com / https://api.chinaordertz.com
NEXT_PUBLIC_APP_URL=https://www.chinaordertz.com
NEXT_PUBLIC_API_URL=https://api.chinaordertz.com
# Server-side Next.js → Laravel inside Docker Compose (runtime; not baked at build)
API_INTERNAL_URL=http://nginx

# ── Payments — production must use NMB, never mock ───────────────────────────
PAYMENT_DEFAULT_GATEWAY=nmb
PAYMENT_ORCHESTRATOR_DEFAULT_PROVIDER=nmb
PAYMENT_NMB_ENABLED=true
NMB_ENVIRONMENT=production
NMB_BASE_URL=
NMB_MERCHANT_ID=
NMB_USERNAME=
NMB_PASSWORD=
NMB_CALLBACK_URL=https://api.your-domain.com/api/v1/payments/nmb/callback
NMB_RETURN_URL=https://your-domain.com/checkout/payment/return
NMB_MERCHANT_NAME="${APP_NAME}"
NMB_MERCHANT_URL="${FRONTEND_URL}"
NMB_AUTO_VERIFY_AFTER_CALLBACK=true
NMB_AUTO_COMPLETE_AFTER_VERIFICATION=true
NMB_PROCESS_CALLBACKS_ASYNC=true
NMB_WEBHOOK_REQUIRE_SIGNATURE=true
NMB_WEBHOOK_SECRET=
NMB_WEBHOOK_SCHEME=notification_secret

# ── Notification Platform ────────────────────────────────────────────────────
NOTIFICATION_EMAIL_DRIVER=smtp
NOTIFICATION_EMAIL_CONFIGURED=true
NOTIFICATION_WHATSAPP_CONFIGURED=false
NOTIFICATION_SMS_CONFIGURED=false
NOTIFICATION_PUSH_CONFIGURED=false

# ── Ops / monitoring ─────────────────────────────────────────────────────────
MONITORING_ENABLED=true
QUEUE_RESTART_ON_BOOT=true
OPS_SCHEDULER_STARTUP_GRACE_MINUTES=5
OPS_SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=10

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_ROOT=/var/backups/china-order-tz
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_DAILY_AT=02:15

# Never enable in production:
# RUN_DEMO_SEEDS=false
# SEED_DATABASE_ON_BOOT=false
# ALLOW_DESTRUCTIVE_DB=false
