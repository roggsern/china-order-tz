# Copy to .env for local Expo. Never commit real secrets.
# Must include the /api/v1 suffix (Laravel apiPrefix).
EXPO_PUBLIC_API_BASE_URL=https://api.chinaordertz.com/api/v1

# Local Docker / machine examples:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: merchant web origin for NMB Website Hosted Checkout launcher
# (`/payments/{transactionId}/nmb` opened in the system browser).
# Backend remains the payment-session authority; mobile only opens returned
# checkout_url (allowlisted) or this merchant launcher — never builds MPGS URLs.
# EXPO_PUBLIC_WEB_APP_BASE_URL=https://chinaordertz.com

# Optional: absolute/relative path to Firebase Android client config for local builds.
# Production EAS should inject GOOGLE_SERVICES_JSON as a file environment variable
# (see app.config.js). Do not commit privileged service-account JSON.
# GOOGLE_SERVICES_JSON=./google-services.json

# Preview/internal builds only: allow opening sandbox NMB/MPGS checkout hosts
# returned by a sandbox-configured backend. Production EAS must keep this false.
# EXPO_PUBLIC_ALLOW_NMB_SANDBOX_CHECKOUT=true

# Optional: extend payment checkout host allowlist (comma-separated hostnames).
# Defaults already include production Mastercard / NMB gateway hosts.
# Mock host checkout.nmb.test is DEV-only and excluded from production profiles.
# EXPO_PUBLIC_PAYMENT_CHECKOUT_ALLOWED_HOSTS=checkout.example.com
# EXPO_PUBLIC_PAYMENT_CHECKOUT_ALLOWED_HOST_SUFFIXES=.gateway.example.com
