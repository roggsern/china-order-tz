{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.chinaordertz.com/api/v1",
        "EXPO_PUBLIC_WEB_APP_BASE_URL": "https://chinaordertz.com",
        "EXPO_PUBLIC_ALLOW_NMB_SANDBOX_CHECKOUT": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.chinaordertz.com/api/v1",
        "EXPO_PUBLIC_WEB_APP_BASE_URL": "https://chinaordertz.com",
        "EXPO_PUBLIC_ALLOW_NMB_SANDBOX_CHECKOUT": "true"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.chinaordertz.com/api/v1",
        "EXPO_PUBLIC_WEB_APP_BASE_URL": "https://chinaordertz.com",
        "EXPO_PUBLIC_ALLOW_NMB_SANDBOX_CHECKOUT": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
