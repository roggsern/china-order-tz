# CHINA ORDER TZ — Authoritative production environment template
# Copy to project root before Docker Compose production deploy:
#   cp .env.production.example .env
# Fill secrets, then validate and deploy:
#   bash scripts/validate-production-deploy.sh
#   bash scripts/deploy-api-compose.sh
#
# Database credential contract:
#   MYSQL_* is the source of truth for Docker Compose and the MySQL container.
#   DB_* must mirror MYSQL_* so Laravel and static tools reading .env stay aligned.
# Generate APP_KEY:
#   docker compose exec api php artisan key:generate --show

# ── MySQL (Compose + container init — source of truth) ───────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=china_order_tz
MYSQL_USER=china_order
MYSQL_PASSWORD=
# MYSQL_PORT is local/dev only (docker-compose.yml). Production resets mysql ports —
# MySQL is internal-only on the Docker network (never publish 3306 on the host).
# Do not rely on MYSQL_PORT in production.

APP_NAME="CHINA ORDER TZ API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Laravel DB (must mirror MYSQL_* above) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=china_order_tz
DB_USERNAME=china_order
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (Resend HTTPS preferred on DigitalOcean; SMTP kept for rollback) ───
# Production recommendation: MAIL_MAILER=resend (HTTPS API — not blocked by DO SMTP filters).
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=orders@chinaordertz.com
MAIL_FROM_NAME="CHINA ORDER TZ"

# Rollback / alternate SMTP (unused when MAIL_MAILER=resend; keep credentials for emergency switch)
# MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_URL=https://your-domain.com
SANCTUM_STATEFUL_DOMAINS=your-domain.com,www.your-domain.com
SANCTUM_ADMIN_EXPIRATION_MINUTES=480
SANCTUM_CUSTOMER_EXPIRATION_MINUTES=10080

# ── Next.js production web image (Docker build args — docker-compose.prod.yml) ─
NEXT_PUBLIC_APP_URL=https://www.chinaordertz.com
NEXT_PUBLIC_API_URL=https://api.chinaordertz.com
# Server-side Next.js → Laravel inside Docker Compose (runtime; not baked at build)
API_INTERNAL_URL=http://nginx
WEB_PORT=3000

# ── Payments — production must use NMB, never mock ───────────────────────────
PAYMENT_DEFAULT_GATEWAY=nmb
PAYMENT_ORCHESTRATOR_DEFAULT_PROVIDER=nmb
PAYMENT_NMB_ENABLED=true
NMB_ENVIRONMENT=production
NMB_BASE_URL=
NMB_MERCHANT_ID=
NMB_USERNAME=
NMB_PASSWORD=
NMB_CALLBACK_URL=https://api.your-domain.com/api/v1/payments/nmb/callback
NMB_RETURN_URL=https://your-domain.com/checkout/payment/return
NMB_MERCHANT_NAME="${APP_NAME}"
NMB_MERCHANT_URL="${FRONTEND_URL}"
NMB_AUTO_VERIFY_AFTER_CALLBACK=true
NMB_AUTO_COMPLETE_AFTER_VERIFICATION=true
NMB_PROCESS_CALLBACKS_ASYNC=true
NMB_WEBHOOK_REQUIRE_SIGNATURE=true
NMB_WEBHOOK_SECRET=
NMB_WEBHOOK_SCHEME=notification_secret

# Snippe mobile money (Payment Orchestrator). Keep disabled until credentials and
# an HTTPS webhook are intentionally configured. Do not commit real secrets.
SNIPPE_ENABLED=false
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_WEBHOOK_URL=
SNIPPE_HTTP_TIMEOUT=30
SNIPPE_HTTP_CONNECT_TIMEOUT=10
SNIPPE_HTTP_RETRY_TIMES=2
SNIPPE_LOG_CHANNEL=stack
SNIPPE_WEBHOOK_REPLAY_TTL_SECONDS=86400
SNIPPE_WEBHOOK_MAX_AGE_SECONDS=300
SNIPPE_WEBHOOK_MAX_FUTURE_SKEW_SECONDS=60

# ── Notification Platform ────────────────────────────────────────────────────
NOTIFICATION_EMAIL_DRIVER=resend
NOTIFICATION_EMAIL_CONFIGURED=true
NOTIFICATION_WHATSAPP_DRIVER=meta_cloud
NOTIFICATION_WHATSAPP_CONFIGURED=false
NOTIFICATION_SMS_CONFIGURED=false
NOTIFICATION_PUSH_CONFIGURED=false

# WhatsApp Meta Cloud API — set CONFIGURED=true only after templates are approved
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_LANGUAGE=en
# WHATSAPP_TEMPLATE_ORDER_CREATED=order_created
# WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=payment_confirmed
# WHATSAPP_TEMPLATE_SHIPMENT_ARRIVED_TANZANIA=shipment_arrived_tanzania
# WHATSAPP_TEMPLATE_ORDER_DELIVERED=order_delivered


# ── Ops / monitoring ─────────────────────────────────────────────────────────
MONITORING_ENABLED=true
QUEUE_RESTART_ON_BOOT=true
OPS_SCHEDULER_STARTUP_GRACE_MINUTES=5
OPS_SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=10

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_ROOT=/var/backups/china-order-tz
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_DAILY_AT=02:15
# Off-site (optional): BACKUP_DRIVER=s3
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1

# Optional deploy toggle: PRE_DEPLOY_BACKUP=auto|true|false (default false)

# Never enable in production:
# RUN_DEMO_SEEDS=false
# SEED_DATABASE_ON_BOOT=false
# ALLOW_DESTRUCTIVE_DB=false
